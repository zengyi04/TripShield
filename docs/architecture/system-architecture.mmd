flowchart TD

  DEV["<b>Devices</b><br/>iOS · Android via Expo Go &nbsp;|&nbsp; Web via React Native Web"]

  subgraph CLIENT["Expo / React Native client &nbsp;—&nbsp; BUILT"]
    direction TB
    APP["<b>App shell</b><br/>bottom navigation · shared theme tokens"]

    F1["<b>Buy Window</b><br/>link to bookable card<br/>price risk · countdown"]
    F2["<b>Consensus</b><br/>Travel DNA swipe<br/>constraint solver"]
    F3["<b>Adaptive Ledger</b><br/>line-item split<br/>budget rebalance"]
    F4["<b>Trip Fix / What-If</b><br/>health score<br/>repaired plan"]

    DATA["<b>Data layer</b><br/>typed trip data · service clients · offline fallback"]
  end

  subgraph SERVER["Backend &nbsp;—&nbsp; PLANNED"]
    direction TB
    PROXY["<b>Serverless proxy</b><br/>/extract · /ocr<br/>keeps the API key off the device"]
    SUPA["<b>Supabase</b><br/>Postgres · Auth · Storage<br/>trips · votes · expenses · receipts"]
  end

  subgraph EXT["External services"]
    direction TB
    GEM["<b>Google Gemini</b><br/>link extraction · receipt OCR"]
    METEO["<b>Open-Meteo</b><br/>hourly weather · keyless"]
    MAPS["<b>ArcGIS static maps</b><br/>route previews · keyless"]
    BOOK["<b>Booking partner</b><br/>deep link to checkout"]
  end

  DEV --> APP
  APP --> F1
  APP --> F2
  APP --> F3
  APP --> F4
  F1 --> DATA
  F2 --> DATA
  F3 --> DATA
  F4 --> DATA

  DATA -->|live| METEO
  DATA -->|live| MAPS
  F1 -->|we hand off, never take payment| BOOK
  DATA -.->|planned| PROXY
  DATA -.->|planned| SUPA
  PROXY --> GEM

  classDef built fill:#DCEBFA,stroke:#2C6FAD,stroke-width:2px,color:#10283D;
  classDef planned fill:#FFF3D6,stroke:#C79A2E,stroke-width:2px,color:#3D3110,stroke-dasharray:5 4;
  classDef external fill:#E6F4EA,stroke:#3C8A57,stroke-width:2px,color:#123322;

  class DEV,APP,F1,F2,F3,F4,DATA built;
  class PROXY,SUPA planned;
  class GEM,METEO,MAPS,BOOK external;

  style CLIENT fill:#F4F9FE,stroke:#2C6FAD,stroke-width:2px
  style SERVER fill:#FFFBF2,stroke:#C79A2E,stroke-width:2px,stroke-dasharray:6 5
  style EXT fill:#F3FAF5,stroke:#3C8A57,stroke-width:2px
