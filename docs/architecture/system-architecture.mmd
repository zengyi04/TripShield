flowchart TD

  subgraph DEV["1 · Devices"]
    DV1["iOS / Android<br/>Expo Go, no build step"]
    DV2["Browser<br/>React Native Web + Vite"]
  end

  subgraph UI["2 · Presentation layer &nbsp;—&nbsp; built"]
    U1["App shell<br/>App.tsx · bottom navigation<br/>Buy Window · Plan · Budget · Fix Trip"]
    U2["Shared components<br/>ScreenTopBar · LedgerHeader<br/>RouteMapPreview"]
    U3["Design tokens<br/>src/utils/appTheme.ts<br/>gradient · type · spacing"]
  end

  subgraph FEAT["3 · Feature modules &nbsp;—&nbsp; built"]
    F1["Buy Window<br/>link to bookable card<br/>price-risk meter · countdown"]
    F2["Consensus<br/>Travel DNA swipe deck<br/>constraint solver · vote tally"]
    F3["Adaptive Ledger<br/>line-item split · uneven tax<br/>forward budget rebalance"]
    F4["Trip Fix / What-If<br/>trip health score<br/>repaired plan · simulation"]
  end

  subgraph DL["4 · Data access layer &nbsp;—&nbsp; built"]
    D1["Typed domain data<br/>src/data/tripRooms.ts<br/>trips · stops · expenses"]
    D2["Service clients<br/>weather · static maps<br/>link extraction (mocked)"]
    D3["Cache + graceful fallback<br/>bundled weather snapshot<br/>manual-entry path"]
  end

  subgraph EDGE["5 · Serverless API proxy &nbsp;—&nbsp; planned"]
    P1["POST /extract<br/>social link to itinerary card"]
    P2["POST /ocr<br/>receipt image to line items"]
    P3["Key vault + rate limiting<br/>the Gemini key never ships<br/>inside the client bundle"]
  end

  subgraph BACK["6 · Supabase &nbsp;—&nbsp; planned"]
    B1["Postgres<br/>trips · votes · expenses<br/>settlements"]
    B2["Auth + row-level security<br/>group membership"]
    B3["Storage<br/>receipt images"]
  end

  subgraph EXT["7 · External services"]
    X2["Open-Meteo<br/>hourly forecast by lat/lng<br/>keyless · live today"]
    X3["ArcGIS World Street Map<br/>static route previews<br/>keyless · live today"]
    X1["Google Gemini<br/>link extraction · vision OCR"]
    X4["Flight price source<br/>history for the risk meter"]
    X5["Booking partner site<br/>deep link to checkout"]
  end

