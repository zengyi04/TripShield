{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "customConditions": [
      "react-native"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "react",
      "react-native"
    ]
  },
  "include": [
    "App.tsx",
    "index.js",
    "src/types.ts",
    "src/utils/**/*",
    "src/data/**/*",
    "src/components/screens/SelfHealingScreen.tsx",
    "src/components/screens/WhatIfSimulatorScreen.tsx",
    "src/components/screens/ConsensusScreen.tsx",
    "src/components/screens/BuyWindowScreen.native.tsx",
    "src/components/screens/LedgerScreen.tsx",
    "src/components/Ledger*.tsx",
    "src/components/ScreenTopBar.tsx",
    "src/components/RouteMapPreview.tsx",
    "src/utils/ledger*.ts",
    "src/data/ledgerMockData.ts",
    "src/data/mockUsers.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vite.config.ts",
    "src/main.tsx",
    "src/App.tsx",
    "src/components/screens/HomeScreen.tsx",
    "src/components/screens/DashboardScreen.tsx",
    "src/components/screens/LoginScreen.tsx",
    "src/components/screens/SignUpScreen.tsx",
    "src/components/screens/WelcomeScreen.tsx"
  ]
}
